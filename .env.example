# --- Supabase (project: Looxmaxxing, ap-south-1) ---------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- OpenAI ----------------------------------------------------------
# Leave blank and the whole app runs on realistic mock data.
# Paste your key here and every AI feature goes live. Nothing else to change.
OPENAI_API_KEY=

# Models (override only if you want to)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Scheduled jobs --------------------------------------------------
# Any long random string. Vercel Cron sends it as a bearer token.
CRON_SECRET=generate-a-long-random-string

# --- App -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: enables the nightly retention sweep and trim reminders ---
SUPABASE_SERVICE_ROLE_KEY=
